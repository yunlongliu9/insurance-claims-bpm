<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:cibseven="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://example.org/insurance">
<process id="coverageCheck"
         name="Versicherungszeitraum prüfen"
         isExecutable="true"
         cibseven:historyTimeToLive="30">
    <startEvent id="start" />

    <serviceTask id="checkCoverage"
             name="Versicherungszeitraum prüfen">

  <extensionElements>
    <cibseven:connector>
      <cibseven:connectorId>http-connector</cibseven:connectorId>
      <cibseven:inputOutput>
        <cibseven:inputParameter name="url">http://app:8081/coverage/check</cibseven:inputParameter>
                  <cibseven:inputParameter name="method">POST</cibseven:inputParameter>
                      <cibseven:inputParameter name="payload">
            <cibseven:script scriptFormat="groovy"><![CDATA[
              groovy.json.JsonOutput.toJson([
                policyStart: execution.getVariable("policyStart"),
                policyEnd: execution.getVariable("policyEnd"),
                treatmentDate: execution.getVariable("treatmentDate")
              ])
            ]]></cibseven:script>
          </cibseven:inputParameter>
        <cibseven:inputParameter name="headers">
          <cibseven:map>
            <cibseven:entry key="Content-Type">application/json</cibseven:entry>
          </cibseven:map>
        </cibseven:inputParameter>

            <cibseven:outputParameter name="withinCoverage">
      <cibseven:script scriptFormat="groovy"><![CDATA[
        new groovy.json.JsonSlurper().parseText(response).withinCoverage
      ]]></cibseven:script>
    </cibseven:outputParameter>
      </cibseven:inputOutput>
    </cibseven:connector>
  </extensionElements>

</serviceTask>
    
    <exclusiveGateway id="coverageGateway" />
    <endEvent id="validEnd" name="Innerhalb des Versicherungszeitraums" />
    <endEvent id="invalidEnd" name="Manuelle Prüfung" />

    <sequenceFlow id="flow1" sourceRef="start" targetRef="checkCoverage" />
    <sequenceFlow id="flow1b" sourceRef="checkCoverage" targetRef="coverageGateway" />
    
    <sequenceFlow id="flow2" sourceRef="coverageGateway" targetRef="validEnd">
      <conditionExpression xsi:type="tFormalExpression">${withinCoverage == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="coverageGateway" targetRef="invalidEnd">
      <conditionExpression xsi:type="tFormalExpression">${withinCoverage == false}</conditionExpression>
    </sequenceFlow>
  </process>
</definitions>
